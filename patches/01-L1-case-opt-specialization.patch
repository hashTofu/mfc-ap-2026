 toolchain/mfc/params/definitions.py           | 18 ++++++++++
 .../mfc/params_tests/test_fortran_gen.py      |  8 ++++-
 8 files changed, 111 insertions(+), 31 deletions(-)

diff --git a/src/common/m_global_parameters_common.fpp b/src/common/m_global_parameters_common.fpp
index 79ea647..b4bff0c 100644
--- a/src/common/m_global_parameters_common.fpp
+++ b/src/common/m_global_parameters_common.fpp
@@ -353,11 +353,15 @@ contains
         t_step_start = dflt_int
 
         ! Simulation algorithm
-        model_eqns = dflt_int
+        #:if not MFC_CASE_OPTIMIZATION
+            model_eqns = dflt_int
+        #:endif
         relax = .false.
         relax_model = dflt_int
-        hypoelasticity = .false.
-        cont_damage = .false.
+        #:if not MFC_CASE_OPTIMIZATION
+            hypoelasticity = .false.
+            cont_damage = .false.
+        #:endif
         hyper_cleaning = .false.
 
         ! Condensed-phase reactive burn
@@ -390,15 +394,17 @@ contains
 
         ! Bubble modeling flags and parameters
         R0ref = dflt_real
-        bubbles_euler = .false.
         polydisperse = .false.
         poly_sigma = dflt_real
-        qbmm = .false.
-        surface_tension = .false.
         adv_n = .false.
         sigma = dflt_real
-        bubbles_lagrange = .false.
-        particles_lagrange = .false.
+        #:if not MFC_CASE_OPTIMIZATION
+            bubbles_euler = .false.
+            qbmm = .false.
+            surface_tension = .false.
+            bubbles_lagrange = .false.
+            particles_lagrange = .false.
+        #:endif
 
         ! Immersed boundaries
         ib = .false.
@@ -414,9 +420,11 @@ contains
         fft_wrt = .false.
 
         ! Mixture conversion and sound-speed behavior
-        avg_state = dflt_int
-        alt_soundspeed = .false.
-        mixture_err = .false.
+        #:if not MFC_CASE_OPTIMIZATION
+            avg_state = dflt_int
+            alt_soundspeed = .false.
+            mixture_err = .false.
+        #:endif
         sigR = dflt_real
         dx_min = dflt_real
         dy_min = dflt_real
