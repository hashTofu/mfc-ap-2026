diff --git a/toolchain/mfc/params_tests/test_fortran_gen.py b/toolchain/mfc/params_tests/test_fortran_gen.py
index ef37e1d..6dd8ffd 100644
--- a/toolchain/mfc/params_tests/test_fortran_gen.py
+++ b/toolchain/mfc/params_tests/test_fortran_gen.py
@@ -121,12 +121,18 @@ def test_common_module_decls_do_not_expand_namelists():
     from mfc.params.definitions import NAMELIST_VARS
     from mfc.params.generators.fortran_gen import generate_decls_fpp, generate_namelist_fpp
 
-    common_decls = ("avg_state", "alt_soundspeed", "mixture_err", "sigR", "riemann_solver")
+    common_decls = ("sigR", "riemann_solver")
     for target in ("pre", "sim", "post"):
         declarations = generate_decls_fpp(target)
         for name in common_decls:
             assert f":: {name}" in declarations
 
+    # Case-optimization params live in generated_case_opt_decls.fpp for sim,
+    # while pre/post declare them in generated_decls.fpp.
+    for opt_common in ("avg_state", "alt_soundspeed", "mixture_err"):
+        assert f":: {opt_common}" in generate_decls_fpp("pre")
+        assert f":: {opt_common}" in generate_decls_fpp("post")
+
     # Viscous is a case-optimization parameter, so simulation declares it in
     # generated_case_opt_decls.fpp instead of generated_decls.fpp.
     assert ":: viscous" in generate_decls_fpp("pre")
