+            null_weights = 1 if self.params.get("null_weights", "F") == "T" else 0
+            weno_Re_flux = 1 if self.params.get("weno_Re_flux", "F") == "T" else 0
+            weno_avg = 1 if self.params.get("weno_avg", "F") == "T" else 0
 
             # Throw error if wenoz_q is required but not set
             out = f"""\
@@ -421,6 +439,24 @@ gbl_id = patch_ib(i)%gbl_patch_id
 #:set igr_order             = {self.params.get("igr_order", 3)}
 #:set viscous               = {viscous}
 #:set riemann_solver        = {riemann_solver}
