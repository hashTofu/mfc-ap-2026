 src/simulation/m_riemann_solver_hllc.fpp | 507 ++++++++++++++++-------
 src/simulation/m_weno.fpp                | 429 ++++++++++++-------
 3 files changed, 713 insertions(+), 292 deletions(-)

diff --git a/src/common/m_variables_conversion.fpp b/src/common/m_variables_conversion.fpp
index 65deb32..092238e 100644
--- a/src/common/m_variables_conversion.fpp
+++ b/src/common/m_variables_conversion.fpp
@@ -410,9 +410,14 @@ contains
             real(wp), dimension(num_fluids) :: alpha_K, alpha_rho_K
             real(wp), dimension(nb)         :: nRtmp
         #:endif
-        real(wp)               :: rhoYks(1:${NUM_SPECIES}$)
+        #:if chemistry
+            real(wp) :: rhoYks(1:${NUM_SPECIES}$)
+        #:else
+            real(wp) :: rhoYks(1)
+        #:endif
         real(wp), dimension(2) :: Re_K
         real(wp)               :: rho_K, gamma_K, pi_inf_K, qv_K, dyn_pres_K
+        real(wp)               :: inv_rho, alpha_K_sum, vel_i
         real(wp)               :: vftmp, nbub_sc
         real(wp)               :: G_K
         real(wp)               :: solid_partial_density
@@ -433,14 +438,70 @@ contains
         integer :: Re_size_loc1, Re_size_loc2
 
         Re_size_loc1 = Re_size(1); Re_size_loc2 = Re_size(2)
-        $:GPU_PARALLEL_LOOP(collapse=3, privateArrays='[alpha_K, alpha_rho_K, Re_K, nRtmp, rhoYks, B]', private='[rho_K, gamma_K, &
-                            & pi_inf_K, qv_K, dyn_pres_K, pres, vftmp, nbub_sc, G_K, solid_partial_density, T, pres_mag, Ga, B2, &
-                            & m2, S, W, dW, E, D, f, dGa_dW, dp_dW, df_dW, iter]', firstprivate='[Re_size_loc1, Re_size_loc2]')
+        #:set _vc_pa = '[alpha_K, alpha_rho_K, Re_K, nRtmp, rhoYks, B]' if chemistry else '[alpha_K, alpha_rho_K, Re_K, nRtmp, B]'
+        $:GPU_PARALLEL_LOOP(collapse=3, privateArrays=_vc_pa, private='[rho_K, gamma_K, &
+                            & pi_inf_K, qv_K, dyn_pres_K, inv_rho, alpha_K_sum, vel_i, pres, vftmp, nbub_sc, G_K, &
+                            & solid_partial_density, T, pres_mag, Ga, B2, m2, S, W, dW, E, D, f, dGa_dW, dp_dW, df_dW, iter]', &
+                            & firstprivate='[Re_size_loc1, Re_size_loc2]')
         do l = ibounds(3)%beg, ibounds(3)%end
             do k = ibounds(2)%beg, ibounds(2)%end
                 do j = ibounds(1)%beg, ibounds(1)%end
                     dyn_pres_K = 0._wp
 
+#ifdef MFC_GPU
+                    ! Compile-time constant fast path for 5-eq pure-fluid Euler on GPU: eliminates all non-inlined ABI calls
+                    if ((model_eqns == model_eqns_5eq) .and. (.not. chemistry) .and. (.not. bubbles_euler) .and. &
+                        & (.not. any_state_dependent_eos) .and. (.not. relativity) .and. (.not. alt_soundspeed) .and. &
+                        & (.not. hypoelasticity) .and. (.not. mhd) .and. (.not. viscous) .and. (.not. igr) .and. &
+                        & (.not. cont_damage) .and. (.not. surface_tension) .and. (.not. bubbles_lagrange) .and. &
+                        & (.not. particles_lagrange)) then
+                        $:GPU_LOOP(parallelism='[seq]')
+                        do i = 1, num_fluids
+                            alpha_rho_K(i) = qK_cons_vf(i)%sf(j, k, l)
+                            alpha_K(i) = qK_cons_vf(eqn_idx%adv%beg + i - 1)%sf(j, k, l)
+                            qK_prim_vf(i)%sf(j, k, l) = alpha_rho_K(i)
+                            qK_prim_vf(eqn_idx%adv%beg + i - 1)%sf(j, k, l) = alpha_K(i)
+                        end do
+                        if (mpp_lim) then
+                            alpha_K_sum = 0._wp
+                            $:GPU_LOOP(parallelism='[seq]')
+                            do i = 1, num_fluids
+                                alpha_rho_K(i) = max(0._wp, alpha_rho_K(i))
+                                alpha_K(i) = min(max(0._wp, alpha_K(i)), 1._wp)
+                                alpha_K_sum = alpha_K_sum + alpha_K(i)
+                            end do
+                            alpha_K_sum = 1._wp/max(alpha_K_sum, 1.e-16_wp)
+                            $:GPU_LOOP(parallelism='[seq]')
+                            do i = 1, num_fluids
+                                alpha_K(i) = alpha_K(i)*alpha_K_sum
+                            end do
+                        end if
+                        rho_K = 0._wp; gamma_K = 0._wp; pi_inf_K = 0._wp; qv_K = 0._wp
+                        $:GPU_LOOP(parallelism='[seq]')
+                        do i = 1, num_fluids
+                            rho_K = rho_K + alpha_rho_K(i)
+                            gamma_K = gamma_K + alpha_K(i)*gammas(i)
+                            pi_inf_K = pi_inf_K + alpha_K(i)*pi_infs(i)
+                            qv_K = qv_K + alpha_rho_K(i)*qvs(i)
+                        end do
+                        if (enforce_density_floor_vc) rho_K = max(rho_K, sgm_eps)
+                        inv_rho = 1._wp/rho_K
+                        $:GPU_LOOP(parallelism='[seq]')
+                        do i = eqn_idx%mom%beg, eqn_idx%mom%end
+                            vel_i = qK_cons_vf(i)%sf(j, k, l)*inv_rho
+                            qK_prim_vf(i)%sf(j, k, l) = vel_i
+                            dyn_pres_K = dyn_pres_K + 5.e-1_wp*qK_cons_vf(i)%sf(j, k, l)*vel_i
+                        end do
+                        pres = (qK_cons_vf(eqn_idx%E)%sf(j, k, l) - dyn_pres_K - pi_inf_K - qv_K)/gamma_K
+                        qK_prim_vf(eqn_idx%E)%sf(j, k, l) = pres
+                        if (heat_conduction) then
+                            q_T_sf%sf(j, k, l) = f_mixture_temperature(alpha_rho_K, pres, gamma_K, pi_inf_K)
+                        end if
+                        if (hyper_cleaning) qK_prim_vf(eqn_idx%psi)%sf(j, k, l) = qK_cons_vf(eqn_idx%psi)%sf(j, k, l)
+                        cycle
+                    end if
+#endif
+
                     call s_compute_species_fraction(qK_cons_vf, j, k, l, alpha_rho_K, alpha_K)
 
 #ifdef MFC_GPU
